uniform float4x4 ViewProj;
uniform float feather_pixels;

struct VertDataIn {
	float4 pos : POSITION;
	float2 uv : TEXCOORD0;
	float2 rect_size : TEXCOORD1;
};

struct VertDataOut {
	float4 pos : POSITION;
	float2 uv : TEXCOORD0;
	float2 rect_size : TEXCOORD1;
};

VertDataOut VSDefault(VertDataIn v_in)
{
	VertDataOut vert_out;
	vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
	vert_out.uv = v_in.uv;
	vert_out.rect_size = v_in.rect_size;
	return vert_out;
}

float SignedBoxDistance(float2 offset_px, float2 half_size)
{
	float2 d = abs(offset_px) - half_size;
	return length(max(d, 0.0)) + min(max(d.x, d.y), 0.0);
}

float4 PSShape(VertDataOut v_in) : TARGET
{
	float geometry_padding = feather_pixels;
	float2 quad_size = v_in.rect_size + geometry_padding * 2.0;
	float2 offset_px = (v_in.uv - 0.5) * quad_size;
	float2 half_size = v_in.rect_size * 0.5;

	// The box itself is fully covered and the feather fades outwards over feather_pixels,
	// reaching zero exactly at the quad edge. The distance outside a box is Euclidean, so
	// the fade has rounded corners. (Rounding the box by feather_pixels instead turned
	// boxes smaller than the feather into circles larger than the quad, cut off square.)
	float box_distance = SignedBoxDistance(offset_px, half_size);
	float final_alpha = feather_pixels > 0.0
		? 1.0 - smoothstep(0.0, feather_pixels, box_distance)
		: (box_distance <= 0.0 ? 1.0 : 0.0);
	return float4(final_alpha, final_alpha, final_alpha, final_alpha);
}

technique Draw
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader = PSShape(v_in);
	}
}
